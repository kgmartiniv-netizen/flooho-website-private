# HubSpot private app access token (Settings > Integrations > Private Apps)
# Needs the "crm.objects.contacts.write" scope.
# Same token used by the standalone ../hubspot-contact-form project — reuse that value.
HUBSPOT_ACCESS_TOKEN=

# --- FL-002/FL-003 webhook (separate self-installed HubSpot OAuth app,
# not the private app above). See flooho-hubspot-webhook-app/ (built via
# the HubSpot CLI, deployed separately from this repo) and
# app/api/hubspot-webhook, app/api/hubspot-oauth-callback. ---

# HubSpot app's Auth tab, in the HubSpot developer account UI (Apps -> the
# webhook app -> Auth). Client secret is also the HMAC key for verifying
# incoming webhook signatures.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# One-time output of /api/hubspot-oauth-callback, right after installing
# the app and authorizing it in HubSpot. Long-lived; not shown again after
# that page — see the code comment there before re-running the install.
HUBSPOT_REFRESH_TOKEN=

# Slack app's OAuth & Permissions page -> Bot User OAuth Token (starts
# "xoxb-"). Needs channels:manage, chat:write, channels:read bot scopes.
SLACK_BOT_TOKEN=

# Jira: id.atlassian.com/manage-profile/security/api-tokens for
# JIRA_API_TOKEN (create one there), paired with the Atlassian account
# email that owns it for JIRA_EMAIL.
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BASE_URL=https://kgmartiniv.atlassian.net
